   "@type": "cr:RecordSet",
   "@id": "hle_records",
   "name": "hle",
   "description": "Life expectancy and healthy life expectancy (HLE) at birth, 3-year pooled, research estimates",
   "field": [
    {
     "@type": "cr:Field",
     "@id": "hle/unit_id",
     "name": "unit_id",
     "description": "FK to units.csv",
     "dataType": "sc:Text",
     "source": {
      "fileObject": {
       "@id": "hle"
      },
      "extract": {
       "column": "unit_id"
      }
     }
    },
    {
     "@type": "cr:Field",
     "@id": "hle/year",
     "name": "year",
     "description": "Centre year of the 3-year window",
     "dataType": "sc:Integer",
     "source": {
      "fileObject": {
       "@id": "hle"
      },
      "extract": {
       "column": "year"
      }
     }
    },
    {
     "@type": "cr:Field",
     "@id": "hle/life_expectancy",
     "name": "life_expectancy",
     "description": "Life expectancy at birth (years), Chiang abridged life table from deaths and mid-year population",
     "dataType": "sc:Float",
     "source": {
      "fileObject": {
       "@id": "hle"
      },
      "extract": {
       "column": "life_expectancy"
      }
     }
    },
    {
     "@type": "cr:Field",
     "@id": "hle/healthy_life_expectancy",
     "name": "healthy_life_expectancy",
     "description": "HLE at birth (years), Sullivan method, unhealthy share calibrated to Statistics Korea national subjective-health HLE",
     "dataType": "sc:Float",
     "source": {
      "fileObject": {
       "@id": "hle"
      },
      "extract": {
       "column": "healthy_life_expectancy"
      }
     }
    },
    {
     "@type": "cr:Field",
     "@id": "hle/unhealthy_years",
     "name": "unhealthy_years",
     "description": "life_expectancy - healthy_life_expectancy",
     "dataType": "sc:Float",
     "source": {
      "fileObject": {
       "@id": "hle"
      },
      "extract": {
       "column": "unhealthy_years"
      }
     }
    },
    {
     "@type": "cr:Field",
     "@id": "hle/good_self_rated_health_3yr",
     "name": "good_self_rated_health_3yr",
     "description": "3-year mean age-standardised good self-rated health (%), the regional input to HLE",
