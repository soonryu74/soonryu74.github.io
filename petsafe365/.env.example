# 실제 값은 .env.local 에 넣고 커밋하지 않는다. 값이 비어 있으면 앱은 "예시 모드"로 실행된다.

# 앱 주소 (매직링크가 돌아올 주소)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase — https://supabase.com/dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 서버 전용. 절대 NEXT_PUBLIC_ 을 붙이지 않는다. 탈퇴 처리와 시드에만 쓴다.
SUPABASE_SERVICE_ROLE_KEY=
# 시드할 때 관리자로 승격할 계정 이메일 (먼저 그 메일로 한 번 로그인해야 한다)
ADMIN_BOOTSTRAP_EMAIL=

# 결제대행사 (계약 후 입력. 입력해도 paymentsEnabled 플래그를 관리자가 켜기 전에는 결제가 열리지 않는다)
NEXT_PUBLIC_PAYMENT_PROVIDER=
NEXT_PUBLIC_PAYMENT_CLIENT_KEY=
PAYMENT_SECRET_KEY=

# 지도·공공데이터 (Phase 2)
# Kakao Developers https://developers.kakao.com → 내 애플리케이션 → 앱 키
NEXT_PUBLIC_KAKAO_MAP_APP_KEY=
KAKAO_REST_API_KEY=
# 공공데이터포털 https://www.data.go.kr → 마이페이지 → 인증키
PUBLIC_DATA_SERVICE_KEY=
# 한국관광공사 TourAPI https://api.visitkorea.or.kr
TOUR_API_SERVICE_KEY=

# 배치·모니터링 (Phase 2)
CRON_SECRET=
SENTRY_DSN=
