  "rules": [
    { "id": "meal.skip_uncovered", "domain": "meal", "result": "check",
      "when": { "all": [ { "fact": "concern.skipsMeals", "op": "eq", "value": true }, { "fact": "meal.uncoveredSlots", "op": "gt", "value": 0 } ] },
      "reason": "식사를 거르는 경우가 있다고 입력했습니다. 주 21끼 중 {meal.uncoveredSlots} 시간대에 식사를 챙기는 일정이 등록되어 있지 않습니다." },
    { "id": "meal.covered", "domain": "meal", "result": "covered",
      "when": { "all": [ { "fact": "concern.skipsMeals", "op": "eq", "value": true }, { "fact": "meal.uncoveredSlots", "op": "eq", "value": 0 } ] },
      "reason": "모든 끼니 시간대에 식사를 챙기는 일정이 등록되어 있습니다." },

    { "id": "meds.service_unscheduled", "domain": "meds", "result": "check",
      "when": { "all": [ { "fact": "concern.forgetsMeds", "op": "eq", "value": true }, { "fact": "service.med_check", "op": "eq", "value": true }, { "fact": "med.coveredDays", "op": "eq", "value": 0 } ] },
      "reason": "복약확인 서비스를 이용 중이라고 선택했지만 요일·시간이 등록되지 않아, 매일 확인되는지 알 수 없습니다." },
    { "id": "meds.none", "domain": "meds", "result": "check",
      "when": { "all": [ { "fact": "concern.forgetsMeds", "op": "eq", "value": true }, { "fact": "service.med_check", "op": "eq", "value": false }, { "fact": "med.coveredDays", "op": "eq", "value": 0 } ] },
      "reason": "약 복용을 잊는 경우가 있다고 입력했습니다. 현재 등록된 일정에서는 정기적인 복약 확인이 확인되지 않았습니다." },
    { "id": "meds.partial", "domain": "meds", "result": "check",
      "when": { "all": [ { "fact": "concern.forgetsMeds", "op": "eq", "value": true }, { "fact": "med.coveredDays", "op": "gt", "value": 0 }, { "fact": "med.coveredDays", "op": "lt", "value": 7 } ] },
      "reason": "약 복용을 잊는 경우가 있다고 입력했습니다. 복약 확인 일정은 주 {med.coveredDays} 있고, {med.missingDaysList}에는 없습니다." },
    { "id": "meds.covered", "domain": "meds", "result": "covered",
      "when": { "all": [ { "fact": "concern.forgetsMeds", "op": "eq", "value": true }, { "fact": "med.coveredDays", "op": "eq", "value": 7 } ] },
      "reason": "매일 복약 확인 일정이 등록되어 있습니다." },

    { "id": "mobility.days_without_visit", "domain": "mobility", "result": "check",
      "when": { "all": [ { "fact": "concern.mobility", "op": "eq", "value": true }, { "fact": "profile.livesAlone", "op": "eq", "value": true }, { "fact": "time.daysWithoutVisit", "op": "gt", "value": 0 } ] },
      "reason": "이동이 어렵다고 입력했고 혼자 사십니다. 사람이 함께하는 일정이 하나도 없는 요일이 {time.daysWithoutVisit}({time.daysWithoutVisitList}) 있습니다." },
    { "id": "mobility.covered", "domain": "mobility", "result": "covered",
      "when": { "all": [ { "fact": "concern.mobility", "op": "eq", "value": true }, { "fact": "time.daysWithoutVisit", "op": "eq", "value": 0 } ] },
      "reason": "매일 사람이 함께하는 일정이 등록되어 있습니다." },

    { "id": "hygiene.no_support", "domain": "hygiene", "result": "check",
      "when": { "all": [ { "fact": "concern.mobility", "op": "eq", "value": true }, { "fact": "hygiene.supportDays", "op": "eq", "value": 0 } ] },
      "reason": "이동이 어렵다고 입력했습니다. 목욕·위생을 도울 수 있는 일정(방문요양·방문목욕·주야간보호)이 등록되어 있지 않습니다." },
    { "id": "hygiene.covered", "domain": "hygiene", "result": "covered",
      "when": { "all": [ { "fact": "concern.mobility", "op": "eq", "value": true }, { "fact": "hygiene.supportDays", "op": "gt", "value": 0 } ] },
      "reason": "위생을 도울 수 있는 일정이 주 {hygiene.supportDays} 등록되어 있습니다." },

    { "id": "hospital.unescorted", "domain": "hospital", "result": "check",
      "when": { "all": [ { "fact": "hospital.unescortedVisits", "op": "gt", "value": 0 },
        { "any": [ { "fact": "profile.livesAlone", "op": "eq", "value": true }, { "fact": "concern.mobility", "op": "eq", "value": true }, { "fact": "concern.recentFall", "op": "eq", "value": true } ] } ] },
      "reason": "병원 진료 일정({hospital.unescortedList})에 동행하거나 이동을 돕는 일정이 등록되어 있지 않습니다." },
    { "id": "hospital.frequent_unplanned", "domain": "hospital", "result": "check",
      "when": { "all": [ { "fact": "concern.frequentHospital", "op": "eq", "value": true }, { "fact": "hospital.visitCount", "op": "eq", "value": 0 }, { "fact": "service.hospital_escort", "op": "eq", "value": false } ] },
      "reason": "병원 방문이 잦다고 입력했지만, 진료 일정과 이동·동행 계획이 등록되어 있지 않습니다." },
    { "id": "hospital.covered", "domain": "hospital", "result": "covered",
      "when": { "all": [ { "fact": "hospital.visitCount", "op": "gt", "value": 0 }, { "fact": "hospital.unescortedVisits", "op": "eq", "value": 0 } ] },
      "reason": "등록된 병원 진료 일정에 동행·가족 일정이 함께 있습니다." },

    { "id": "cognition.no_program", "domain": "cognition", "result": "check",
      "when": { "all": [ { "fact": "concern.memory", "op": "eq", "value": true }, { "fact": "cognition.sessions", "op": "eq", "value": 0 } ] },
      "reason": "기억력이 걱정된다고 입력했습니다. 현재 등록된 일정에 상담·인지 프로그램 등 확인 일정이 없습니다." },
    { "id": "cognition.covered", "domain": "cognition", "result": "covered",
      "when": { "all": [ { "fact": "concern.memory", "op": "eq", "value": true }, { "fact": "cognition.sessions", "op": "gt", "value": 0 } ] },
      "reason": "인지 관련 일정이 주 {cognition.sessions} 등록되어 있습니다." },

    { "id": "fall.day_alone", "domain": "fall", "result": "check",
