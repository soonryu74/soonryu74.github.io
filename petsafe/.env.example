# ── 펫안심365 환경변수 ─────────────────────────────────────────────
# 실제 값은 .env.local 에만 두고 절대 커밋하지 않는다.
# NEXT_PUBLIC_ 접두사가 붙은 값만 브라우저에 노출된다.

# 앱 주소 (매직링크 리다이렉트에 사용)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase — https://supabase.com/dashboard → Project Settings → API
# 두 값이 비어 있으면 앱은 '예시 모드'로 동작한다(로컬 파일 저장, 예시 데이터 표시).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 서버 전용. 회원 탈퇴(auth 사용자 삭제)에만 사용. 클라이언트에 노출 금지.
SUPABASE_SERVICE_ROLE_KEY=

# Kakao — https://developers.kakao.com → 내 애플리케이션 → 앱 키 (Phase 2)
NEXT_PUBLIC_KAKAO_MAP_APP_KEY=
KAKAO_REST_API_KEY=

# 공공데이터포털 — https://www.data.go.kr (전국 동물병원 등 인허가 데이터)
PUBLIC_DATA_SERVICE_KEY=
# 한국관광공사 TourAPI — https://api.visitkorea.or.kr (반려동물 동반여행)
TOUR_API_SERVICE_KEY=

# 배치 동기화 엔드포인트 보호용 임의 문자열
CRON_SECRET=
# 이 이메일로 처음 로그인하는 사용자에게 관리자 역할을 부여한다(마이그레이션 0001 참고)
ADMIN_BOOTSTRAP_EMAIL=
# 오류 수집(선택)
SENTRY_DSN=

# 예시 모드 저장 위치(선택, 기본 .demo-data)
PETSAFE_DEMO_DIR=
